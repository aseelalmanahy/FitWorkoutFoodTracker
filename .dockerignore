# Secrets and developer state must never reach an image. Next.js would load a .env file at startup.
.env
.env.*
!.env.example
.git
.next
node_modules
*.tsbuildinfo
.claude
.idea
docs
.mail-outbox
live-provider-report.json

# Local account passwords (review, demo) and downloaded models and evaluation photos: never in any image layer.
*.local.md
.cache
# The deploy folder's env files, written on servers and in CI, never go into a build context.
deploy/*.env
