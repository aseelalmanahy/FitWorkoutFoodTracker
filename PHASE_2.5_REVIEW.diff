+++ b/scripts/lib/live-verdict.cjs
@@ -0,0 +1,40 @@
+// Verdict logic for scripts/live-provider-check.cjs (pure; unit-tested).
+//
+// Evidence per provider (USDA, OPEN_FOOD_FACTS):
+//   origin: "real"    the server-recorded Food.origin is the provider's real host
+//           "other"   the origin is some other host (stub/mock/proxy) → contradicts live
+//           "unknown" no food from this provider was fetched (e.g. the check failed)
+//   count:  number    result count of a SUCCESSFUL search, or null if the search failed
+// Rules:
+//   NOT LIVE    any contradiction: a stub override env var is set, an origin is "other", or a
+//               successful search returned fewer results than the real service does
+//   INCOMPLETE  no contradiction but evidence is missing for either provider, or any
+//               check FAILED / NOT RUN, or the run stopped early
+//   PASSED      both providers have real origin + plausible counts, and every check PASSED
+"use strict";
+
+const MIN_COUNTS = { USDA: 5, OPEN_FOOD_FACTS: 3 };
+const REAL_HOSTS = { USDA: "api.nal.usda.gov", OPEN_FOOD_FACTS: "world.openfoodfacts.org" };
+
+function decideVerdict({ results, evidence, envOverrides = [], crashed = false }) {
+  const contradictions = [...envOverrides.map((v) => `${v} is set (stub/override endpoint)`)];
+  const missing = [];
+  for (const p of ["USDA", "OPEN_FOOD_FACTS"]) {
+    const e = evidence[p] || {};
+    if (e.origin === "other") contradictions.push(`${p} data was produced by "${e.originHost}", not ${REAL_HOSTS[p]}`);
+    else if (e.origin !== "real") missing.push(`no ${p} food origin could be checked`);
+    if (typeof e.count === "number") {
+      if (e.count < MIN_COUNTS[p]) contradictions.push(`${p} search returned ${e.count} results (the real service returns ≥ ${MIN_COUNTS[p]})`);
+    } else missing.push(`no successful ${p} search to check result volume`);
+  }
+  const summary = { PASS: 0, FAIL: 0, "NOT RUN": 0 };
+  for (const r of results) summary[r.status]++;
+  let verdict, live;
+  if (contradictions.length) { verdict = "NOT LIVE"; live = false; }
+  else if (missing.length || crashed || summary.FAIL || summary["NOT RUN"]) { verdict = "INCOMPLETE OR FAILED"; live = missing.length ? null : true; }
+  else { verdict = "PASSED"; live = true; }
+  const exitCode = verdict === "PASSED" ? 0 : verdict === "NOT LIVE" ? 3 : 1;
+  return { verdict, live, exitCode, contradictions, missing, summary };
+}
+
+module.exports = { decideVerdict, MIN_COUNTS, REAL_HOSTS };
diff --git a/scripts/lib/test-db-guard.cjs b/scripts/lib/test-db-guard.cjs
new file mode 100644
index 0000000..a9f7192
--- /dev/null
+++ b/scripts/lib/test-db-guard.cjs
@@ -0,0 +1,70 @@
+// Shared guard for any tool that MODIFIES a database's test-database marker
+// (scripts/mark-test-database.cjs and scripts/live-provider-check.safety.test.cjs).
+//
+// A database may only be marked/unmarked when ALL of these hold:
+//   1. The URL is postgres:// or postgresql:// with a LOCAL host: localhost, 127.0.0.1 or ::1.
+//      No `host=` query override (it can redirect to another server or socket).
+//   2. The database name contains "test" and uses only letters, digits and "_".
+//   3. An explicit confirmation value equals the database name exactly.
+//   4. After connecting, current_database() equals that name, and the server address
+//      is loopback (127.0.0.1 / ::1) or a local socket (NULL), which catches hosts-file or
+//      proxy redirection to a remote server.
+// Checks 1–3 run before any connection is opened; check 4 runs before any write.
+"use strict";
+
+const LOCAL_HOSTS = new Set(["localhost", "127.0.0.1", "::1", "[::1]"]);
+const TEST_DB_MARKER_PREFIX = "fitworkoutfoodtracker:test-database:v1:";
+
+/**
+ * Static checks (no connection). Returns { ok, errors, dbName, host }.
+ * @param {string|undefined} url
+ * @param {string|undefined} confirm
+ */
+function validateTargetUrl(url, confirm) {
+  const errors = [];
+  let dbName = null, host = null;
+  if (!url) return { ok: false, errors: ["no database URL was given"], dbName, host };
+  let u;
+  try { u = new URL(url); } catch { return { ok: false, errors: ["the database URL can't be parsed"], dbName, host }; }
+  if (!["postgres:", "postgresql:"].includes(u.protocol)) errors.push(`unsupported protocol "${u.protocol}" (expected postgresql:)`);
+  host = u.hostname;
+  if (!LOCAL_HOSTS.has(host)) errors.push(`database host "${host || "(none)"}" is not local (allowed: localhost, 127.0.0.1, ::1)`);
+  if (u.searchParams.has("host")) errors.push('the URL has a "host=" parameter, which can redirect the connection; remove it');
+  dbName = decodeURIComponent(u.pathname.replace(/^\//, ""));
+  if (!/^[A-Za-z0-9_]+$/.test(dbName)) errors.push(`database name "${dbName}" must use only letters, digits and _`);
+  else if (!/test/i.test(dbName)) errors.push(`database name "${dbName}" doesn't contain "test"`);
+  if (confirm === undefined || confirm === null || confirm === "") errors.push(`no confirmation given (it must equal the database name "${dbName}")`);
+  else if (confirm !== dbName) errors.push(`confirmation "${confirm}" doesn't match the database name "${dbName}"`);
+  return { ok: errors.length === 0, errors, dbName, host };
+}
+
+/**
+ * Post-connection check (read-only). `query` runs SQL and returns rows.
+ * Throws if the connected database or server isn't the validated local test database.
+ */
+async function assertConnectedTarget(query, expectedName) {
+  const rows = await query("SELECT current_database() AS name, host(inet_server_addr()) AS addr");
+  const { name, addr } = rows[0] || {};
+  if (name !== expectedName) throw new Error(`connected to database "${name}", expected "${expectedName}"`);
+  if (addr !== null && addr !== undefined && addr !== "127.0.0.1" && addr !== "::1") {
+    throw new Error(`the database server address ${addr} is not local`);
+  }
+}
+
+/** Replace secret values (URL passwords, keys) in any message before printing it. */
+function redact(message, secrets) {
+  let out = String(message);
+  for (const s of secrets) if (s && s.length >= 3) out = out.split(s).join("<redacted>");
+  return out;
+}
+
+/** Secret forms of the password in a database URL (encoded and decoded), for redaction. */
+function urlSecrets(url) {
+  try {
+    const u = new URL(url);
+    if (!u.password) return [];
+    return [...new Set([u.password, decodeURIComponent(u.password)])];
+  } catch { return []; }
+}
+
+module.exports = { validateTargetUrl, assertConnectedTarget, redact, urlSecrets, TEST_DB_MARKER_PREFIX, LOCAL_HOSTS };
diff --git a/scripts/lib/test-servers.cjs b/scripts/lib/test-servers.cjs
new file mode 100644
index 0000000..ae83cbc
--- /dev/null
+++ b/scripts/lib/test-servers.cjs
@@ -0,0 +1,122 @@
+// Cross-platform helpers for tests that spawn the app, the stub and scripts
+// (used by scripts/*.test.cjs). Windows-safe: no `npx`, no POSIX process groups on win32.
+"use strict";
+const { spawn, spawnSync } = require("node:child_process");
+const net = require("node:net");
+const path = require("node:path");
+
+const ROOT = path.resolve(__dirname, "..", "..");
+const NEXT_BIN = path.join(ROOT, "node_modules", "next", "dist", "bin", "next");
+const children = new Set();
+
+/** Ask the OS for a free TCP port on localhost. */
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = net.createServer();
+    srv.unref();
+    srv.on("error", reject);
+    srv.listen(0, "127.0.0.1", () => {
+      const { port } = srv.address();
+      srv.close(() => resolve(port));
+    });
+  });
+}
+
+/** Resolve true if something accepts connections on the port. */
+function portInUse(port) {
+  return new Promise((resolve) => {
+    const s = net.connect({ port, host: "127.0.0.1" });
+    s.once("connect", () => { s.destroy(); resolve(true); });
+    s.once("error", () => resolve(false));
+  });
+}
+
+/** Spawn `node <args>` (cwd = repo root), tracked for cleanup. NODE_PATH is removed. */
+function spawnNode(args, env = {}, { capture = false } = {}) {
+  const e = { ...process.env, ...env };
+  delete e.NODE_PATH;
+  // Set by `node --test` for its workers. A nested `node --test` that inherits it runs in
+  // child-reporter mode and exits 0 even when tests fail, so never pass it on.
+  delete e.NODE_TEST_CONTEXT;
+  const child = spawn(process.execPath, args, {
+    cwd: ROOT, env: e,
+    detached: process.platform !== "win32", // own process group on POSIX, so the whole tree can be killed
+    stdio: capture ? ["ignore", "pipe", "pipe"] : "ignore",
+    windowsHide: true,
+  });
+  children.add(child);
+  child.once("exit", () => children.delete(child));
+  return child;
+}
+
+/** Kill a child and its whole process tree; resolves when it has exited (max 10 s). */
+function killTree(child) {
+  if (!child || child.exitCode !== null || child.signalCode !== null) return Promise.resolve();
+  return new Promise((resolve) => {
+    const t = setTimeout(resolve, 10_000);
+    child.once("exit", () => { clearTimeout(t); resolve(); });
+    try {
+      if (process.platform === "win32") spawnSync("taskkill", ["/pid", String(child.pid), "/T", "/F"], { stdio: "ignore", windowsHide: true });
+      else process.kill(-child.pid, "SIGTERM");
+    } catch { try { child.kill("SIGKILL"); } catch {} }
+  });
+}
+
+/** Wait until `url` answers (< 500). Fails fast if `child` exits first (so a foreign server on the port can't be mistaken for ours). */
+async function waitForChild(url, child, ms = 45_000) {
+  const t0 = Date.now();
+  for (;;) {
+    if (child && (child.exitCode !== null || child.signalCode !== null)) throw new Error(`process for ${url} exited early (code ${child.exitCode})`);
+    try { const r = await fetch(url); if (r.status < 500) return; } catch {}
+    if (Date.now() - t0 > ms) throw new Error(`timeout waiting for ${url}`);
+    await new Promise((r) => setTimeout(r, 300));
+  }
+}
+
+/** Start the production build (`next start`) on a free, verified-unused port. */
+async function startApp(env) {
+  const port = await freePort();
+  if (await portInUse(port)) throw new Error(`port ${port} unexpectedly in use`);
+  const child = spawnNode([NEXT_BIN, "start", "-p", String(port)], env);
+  await waitForChild(`http://localhost:${port}/login`, child);
+  return { child, port, url: `http://localhost:${port}` };
+}
+
+/** Start scripts/stub-food-apis.cjs on a free port. */
+async function startStub(env = {}) {
+  const port = await freePort();
+  const child = spawnNode([path.join(ROOT, "scripts", "stub-food-apis.cjs"), String(port)], env);
+  await waitForChild(`http://localhost:${port}/off/cgi/search.pl?search_terms=x`, child);
+  return { child, port, url: `http://localhost:${port}` };
+}
+
+/** Run `node <script> <args>` to completion with a hard timeout; returns { code, out, timedOut }. */
+function runNode(scriptArgs, env, timeoutMs = 300_000) {
+  return new Promise((resolve) => {
+    const child = spawnNode(scriptArgs, env, { capture: true });
+    let out = "", timedOut = false;
+    child.stdout.on("data", (d) => (out += d));
+    child.stderr.on("data", (d) => (out += d));
+    const t = setTimeout(() => { timedOut = true; killTree(child); }, timeoutMs);
+    child.on("close", (code) => { clearTimeout(t); resolve({ code, out, timedOut, child }); });
+  });
+}
+
+/** Kill every tracked child (call from test `after`, and on process exit/signals). */
+async function killAll() {
+  await Promise.all([...children].map(killTree));
+}
+const syncKillAll = () => {
+  for (const c of children) {
+    try {
+      if (process.platform === "win32") spawnSync("taskkill", ["/pid", String(c.pid), "/T", "/F"], { stdio: "ignore", windowsHide: true });
+      else process.kill(-c.pid, "SIGKILL");
+    } catch {}
+  }
+};
+process.once("exit", syncKillAll);
+for (const sig of ["SIGINT", "SIGTERM", "SIGHUP", "SIGBREAK"]) {
+  try { process.once(sig, () => { syncKillAll(); process.exit(130); }); } catch {}
+}
+
+module.exports = { ROOT, NEXT_BIN, freePort, portInUse, spawnNode, killTree, waitForChild, startApp, startStub, runNode, killAll, children };
