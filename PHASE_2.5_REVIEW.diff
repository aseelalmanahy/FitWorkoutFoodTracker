+const OTHER = process.env.SAFETY_OTHER_DB_URL || "postgresql://fit:<redacted>@localhost:5432/fitdb_test_other?schema=public";
+const STUB_PORT = 4020, PORT = 3320, DEAD_PORT = 3329;
+const procs = [];
+const MARKER_PREFIX = "fitworkoutfoodtracker:test-database:v1:";
+const dbNameOf = (url) => decodeURIComponent(new URL(url).pathname.replace(/^\//, ""));
+const SERVER_DB_NAME = dbNameOf(DB);
+const dbs = { server: new PrismaClient({ datasources: { db: { url: DB } } }), other: new PrismaClient({ datasources: { db: { url: OTHER } } }) };
+
+function start(cmd, args, env) {
+  const env2 = { ...process.env, ...env };
+  delete env2.NODE_PATH;
+  const p = spawn(cmd, args, { cwd: ROOT, env: env2, detached: true, stdio: "ignore" });
+  procs.push(p);
+  return p;
+}
+/** Stop a process group and wait until it has exited, so the next test can reuse the port. */
+function stop(p) {
+  if (p.exitCode !== null || p.signalCode !== null) return Promise.resolve();
+  return new Promise((resolve) => {
+    const t = setTimeout(resolve, 10_000);
+    p.once("exit", () => { clearTimeout(t); resolve(); });
+    try { process.kill(-p.pid, "SIGTERM"); } catch { clearTimeout(t); resolve(); }
+  });
+}
+async function waitFor(url, ms = 30_000) {
+  const t0 = Date.now();
