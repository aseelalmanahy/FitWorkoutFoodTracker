+    if (set && set.startsWith("fit_session=")) cookie = set.split(";")[0];
+    const text = await res.text();
+    bodies.push(text);
+    let json = null;
+    try { json = JSON.parse(text); } catch {}
+    return { status: res.status, body: json, ms: Date.now() - t0 };
+  };
