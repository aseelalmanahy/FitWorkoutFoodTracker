+// Regression tests for the database-safety guards of scripts/live-provider-check.cjs.
+// Proves the script verifies the RUNNING SERVER's database, and its explicit test-database
+// marker, before any write. A mismatch, a missing or invalid marker, or an unverifiable
+// server makes it exit 4 with NO rows created anywhere.
+// The test (re)marks SAFETY_DB_URL's database with scripts/mark-test-database.cjs and leaves
+// it marked; it never marks SAFETY_OTHER_DB_URL.
+//
+// Self-contained: starts its own stub (scripts/stub-food-apis.cjs) and app servers from the
+// existing production build (run `npm run build` first). Needs two migrated test databases:
+//   SAFETY_DB_URL        the database the app server uses (default: postgresql://fit:<redacted>@localhost:5432/fitdb_test)
+//   SAFETY_OTHER_DB_URL  a different database the script is pointed at (default: …/fitdb_test_other)
+//   node --test scripts/live-provider-check.safety.test.cjs
+const { test, before, after } = require("node:test");
+const assert = require("node:assert/strict");
+const { spawn } = require("node:child_process");
+const path = require("node:path");
+const { PrismaClient } = require("@prisma/client");
+
+const ROOT = path.resolve(__dirname, "..");
