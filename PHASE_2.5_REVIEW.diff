+    inflight.set(req, controller);
+    let res, text;
+    try {
+      res = await req;
+      text = await res.text();
+    } catch (e) {
+      if (controller.signal.aborted) {
+        throw new Error(`${method} ${path}: ${controller.signal.reason?.message || "aborted"}`);
+      }
+      throw e;
+    } finally {
+      clearTimeout(timer);
+      inflight.delete(req);
+    }
