+    p.stdout.on("data", (d) => (out += d));
+    p.stderr.on("data", (d) => (out += d));
+    p.on("close", (code) => resolve({ code, out }));
+  });
+}
+/** Every row the script could create, in a database. */
+async function counts(db) {
+  const [users, sessions, entries, targets, customFoods] = await Promise.all([
+    db.user.count(), db.session.count(), db.foodEntry.count(), db.nutritionTarget.count(), db.food.count({ where: { userId: { not: null } } }),
+  ]);
+  return { users, sessions, entries, targets, customFoods };
+}
+const snapshot = async () => ({ server: await counts(dbs.server), other: await counts(dbs.other) });
+
+/** Run the provisioning script for a database URL with extra args. */
+function markScript(url, args) {
+  return new Promise((resolve) => {
+    const env = { ...process.env, DATABASE_URL: url };
+    delete env.NODE_PATH;
+    const p = spawn(process.execPath, [path.join(ROOT, "scripts/mark-test-database.cjs"), ...args], { cwd: ROOT, env });
+    let out = "";
+    p.stdout.on("data", (d) => (out += d));
+    p.stderr.on("data", (d) => (out += d));
+    p.on("close", (code) => resolve({ code, out }));
+  });
+}
+const readMarker = async () =>
+  (await dbs.server.$queryRawUnsafe("SELECT shobj_description((SELECT oid FROM pg_database WHERE datname = current_database()), 'pg_database') AS m"))[0].m;
+/** Simulate tampering or a restored copy by writing the comment directly. */
+const setMarkerRaw = (value) =>
+  dbs.server.$executeRawUnsafe(`COMMENT ON DATABASE "${SERVER_DB_NAME}" IS ${value === null ? "NULL" : `'${value.replace(/'/g, "''")}'`}`);
+const markProperly = async () => {
+  const r = await markScript(DB, ["--confirm", SERVER_DB_NAME]);
+  assert.equal(r.code, 0, r.out);
+};
+
+before(async () => {
+  await dbs.server.$queryRaw`SELECT 1`;
+  await dbs.other.$queryRaw`SELECT 1`;
+  await markProperly(); // deliberate provisioning step for the dedicated test database
+  assert.equal(await readMarker(), MARKER_PREFIX + SERVER_DB_NAME);
+  start(process.execPath, ["scripts/stub-food-apis.cjs", String(STUB_PORT)], {});
+  await waitFor(`http://localhost:${STUB_PORT}/off/cgi/search.pl?search_terms=x`);
+});
+after(async () => {
+  await Promise.all(procs.map(stop));
+  await dbs.server.$disconnect();
+  await dbs.other.$disconnect();
+});
+
+test("mismatch: server on one test DB, script on another → exit 4 before any write; no rows in either DB", { timeout: 120_000 }, async () => {
+  const app = await startApp({ EXPOSE_DB_IDENTITY: "1" });
+  const before = await snapshot();
+  const r = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: OTHER });
+  const after = await snapshot();
+  await stop(app);
+  assert.equal(r.code, 4, r.out);
+  assert.match(r.out, /REFUSED \(nothing was written\): the server's database does not match/);
+  assert.doesNotMatch(r.out, /Verified before any write|PASS|Cleanup/);
+  assert.deepEqual(after, before, "no rows created in the server's DB or the script's DB");
+});
+
+test("server can't prove its database (identity endpoint disabled) → exit 4, no rows", { timeout: 120_000 }, async () => {
+  const app = await startApp({}); // production build without EXPOSE_DB_IDENTITY → endpoint returns 404
+  const before = await snapshot();
+  const r = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: DB });
+  const after = await snapshot();
+  await stop(app);
+  assert.equal(r.code, 4, r.out);
+  assert.match(r.out, /doesn't expose \/api\/health\/db-identity/);
+  assert.deepEqual(after, before);
+});
+
+test("server unreachable → exit 4, no rows", { timeout: 60_000 }, async () => {
+  const before = await snapshot();
+  const r = await runScript({ BASE_URL: `http://localhost:${DEAD_PORT}`, DATABASE_URL: DB });
+  const after = await snapshot();
+  assert.equal(r.code, 4, r.out);
+  assert.match(r.out, /can't reach/);
+  assert.deepEqual(after, before);
+});
+
+test("non-test database name and non-local BASE_URL → exit 4, no rows", { timeout: 60_000 }, async () => {
+  const before = await snapshot();
+  const devName = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: DB.replace(/\/[^/?]+(\?|$)/, "/fitdb$1") });
+  const remote = await runScript({ BASE_URL: "https://example.com", DATABASE_URL: DB });
+  assert.equal(devName.code, 4, devName.out);
+  assert.match(devName.out, /doesn't look like a test database/);
+  assert.equal(remote.code, 4, remote.out);
+  assert.match(remote.out, /is not local/);
+  assert.deepEqual(await snapshot(), before);
+});
+
+test("matching DB: verification passes BEFORE the first write; run proceeds; cleanup restores row counts", { timeout: 180_000 }, async () => {
+  const app = await startApp({ EXPOSE_DB_IDENTITY: "1" });
+  const before = await snapshot();
+  const r = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: DB });
+  const after = await snapshot();
+  await stop(app);
+  assert.match(r.out, /Verified before any write: the server uses this script's database \("[^"]+"\), and it carries a valid test-database marker/);
+  assert.ok(r.out.indexOf("Verified before any write") < r.out.indexOf("PASS"), "verification is reported before any check");
+  assert.equal(r.code, 3, "stub data must be reported NOT LIVE");
+  assert.match(r.out, /LIVE VERIFICATION: NOT LIVE/);
+  assert.match(r.out, /remaining → users 0, entries 0, custom foods 0, targets 0/);
+  assert.deepEqual(after.other, before.other, "the other DB is untouched");
+  assert.deepEqual(
+    { users: after.server.users, sessions: after.server.sessions, entries: after.server.entries, targets: after.server.targets, customFoods: after.server.customFoods },
+    before.server, "every row the run created was removed",
+  );
+});
+
+// ─── Explicit test-database marker ──────────────────────────────────────────
+
+test("provisioning script refuses without the exact --confirm name and leaves the marker unchanged", { timeout: 60_000 }, async () => {
+  const before = await readMarker();
+  for (const args of [[], ["--confirm"], ["--confirm", "fitdb"], ["--remove", "--confirm", "wrong"]]) {
+    const r = await markScript(DB, args);
+    assert.equal(r.code, 4, `${args.join(" ")}: ${r.out}`);
+    assert.match(r.out, /NOT MARKED/);
+  }
+  assert.equal(await readMarker(), before);
+});
+
+test("MISSING marker: matching DB but no test-database marker → exit 4 before any write, no rows", { timeout: 120_000 }, async () => {
+  const unmark = await markScript(DB, ["--remove", "--confirm", SERVER_DB_NAME]);
+  assert.equal(unmark.code, 0, unmark.out);
+  assert.equal(await readMarker(), null);
+  const app = await startApp({ EXPOSE_DB_IDENTITY: "1" });
+  try {
+    const ident = await (await fetch(`http://localhost:${PORT}/api/health/db-identity`)).json();
+    assert.equal(ident.testMarker, null, "endpoint reports the marker as missing");
+    const before = await snapshot();
+    const r = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: DB });
+    const after = await snapshot();
+    assert.equal(r.code, 4, r.out);
+    assert.match(r.out, /REFUSED \(nothing was written\): the server's database "[^"]+" has no test-database marker/);
+    assert.doesNotMatch(r.out, /Verified before any write|PASS|Cleanup/);
+    assert.deepEqual(after, before, "no rows created in either DB");
+  } finally {
+    await stop(app);
+    await markProperly();
+  }
+});
+
+for (const [label, value] of [
+  ["garbage value", "not a marker"],
+  ["marker for a different database (e.g. restored copy)", `${MARKER_PREFIX}fitdb`],
+  ["wrong marker version", `fitworkoutfoodtracker:test-database:v0:${SERVER_DB_NAME}`],
+]) {
+  test(`INVALID marker (${label}) → exit 4 before any write, no rows`, { timeout: 120_000 }, async () => {
+    await setMarkerRaw(value);
+    const app = await startApp({ EXPOSE_DB_IDENTITY: "1" });
+    try {
+      const before = await snapshot();
+      const r = await runScript({ BASE_URL: `http://localhost:${PORT}`, DATABASE_URL: DB });
+      const after = await snapshot();
+      assert.equal(r.code, 4, r.out);
+      assert.match(r.out, /REFUSED \(nothing was written\): the server's database "[^"]+" has an invalid test-database marker/);
+      assert.doesNotMatch(r.out, /Verified before any write|PASS|Cleanup/);
+      assert.deepEqual(after, before, "no rows created in either DB");
+    } finally {
+      await stop(app);
+      await markProperly();
+    }
+  });
+}
diff --git a/scripts/mark-test-database.cjs b/scripts/mark-test-database.cjs
new file mode 100644
index 0000000..7c096cd
--- /dev/null
+++ b/scripts/mark-test-database.cjs
@@ -0,0 +1,43 @@
+// Deliberately mark the database in DATABASE_URL as a dedicated TEST database, so that
+// scripts/live-provider-check.cjs is allowed to write throwaway records to it.
+// The marker is a PostgreSQL database comment:
+//   fitworkoutfoodtracker:test-database:v1:<database name>
+// Migrations never set it, so a development or production database is never marked by
+// accident. Only run this on a database created solely for testing.
+//
+// Usage (the --confirm value must repeat the database name exactly):
+//   node --env-file=.env.test scripts/mark-test-database.cjs --confirm fitdb_test
+//   node --env-file=.env.test scripts/mark-test-database.cjs --remove --confirm fitdb_test
+const { PrismaClient } = require("@prisma/client");
+
+const PREFIX = "fitworkoutfoodtracker:test-database:v1:";
+const args = process.argv.slice(2);
+const confirm = args[args.indexOf("--confirm") + 1];
+const remove = args.includes("--remove");
+
+function fail(msg) {
+  console.error(`NOT MARKED: ${msg}`);
+  process.exit(4);
+}
+if (!process.env.DATABASE_URL) fail("DATABASE_URL is not set.");
+let dbName;
+try { dbName = decodeURIComponent(new URL(process.env.DATABASE_URL).pathname.replace(/^\//, "")); } catch { fail("DATABASE_URL can't be parsed."); }
+if (!args.includes("--confirm") || confirm !== dbName) {
+  fail(`to ${remove ? "unmark" : "mark"} "${dbName}", repeat its name: --confirm ${dbName}`);
+}
+if (!/^[A-Za-z0-9_]+$/.test(dbName)) fail(`unsupported database name "${dbName}" (letters, digits and _ only).`);
+
+(async () => {
+  const prisma = new PrismaClient();
+  try {
+    const [{ current }] = await prisma.$queryRawUnsafe("SELECT current_database() AS current");
+    if (current !== dbName) fail(`connected to "${current}", expected "${dbName}".`);
+    // Identifier is validated above; COMMENT ON DATABASE doesn't accept bind parameters.
+    await prisma.$executeRawUnsafe(remove ? `COMMENT ON DATABASE "${dbName}" IS NULL` : `COMMENT ON DATABASE "${dbName}" IS '${PREFIX}${dbName}'`);
+    console.log(remove ? `Removed the test-database marker from "${dbName}".` : `Marked "${dbName}" as a dedicated test database.`);
+  } catch (e) {
+    fail(e.message);
+  } finally {
+    await prisma.$disconnect();
+  }
+})();
