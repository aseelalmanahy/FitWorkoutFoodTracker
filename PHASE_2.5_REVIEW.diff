+  if ([n.kcal, n.protein, n.carbs, n.fat].some((v) => v == null)) return null;
+  const est = 4 * n.protein + 4 * n.carbs + 9 * n.fat;
+  return { est: Math.round(est), diff: Math.round(n.kcal - est) };
