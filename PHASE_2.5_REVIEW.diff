+// LIVE provider verification for Phase 2 (USDA FoodData Central + Open Food Facts).
+//
+// Drives a RUNNING local instance of this app through its own HTTP API, so every
+// provider call goes through the existing server-side clients (no separate
+// integration, no mocks, no stubs).
+//
+// Usage, with the app running against a TEST database and your real .env:
+//   node --env-file=.env scripts/live-provider-check.cjs
+// The script must see the same DATABASE_URL as the server (use the same .env).
+// Env options: BASE_URL (default http://localhost:3000), REPORT_FILE (default
+// live-provider-report.json, listed in .gitignore), LIVE_CHECK_ALLOW_DATABASE
+// (see safety guard 2).
+//
+// SAFETY GUARDS (the script refuses to run, exit code 4, BEFORE any write anywhere):
+//   1. BASE_URL must be localhost / 127.0.0.1 / [::1]. It never targets a deployed app.
+//   2. The database name in DATABASE_URL must contain "test" (e.g. fitdb_test), unless
+//      LIVE_CHECK_ALLOW_DATABASE is set to exactly that database name, which acknowledges
+//      that throwaway rows are written there and cleaned up.
+//   3. The RUNNING SERVER's actual database must be that same database. The script reads an
+//      opaque fingerprint from the server (GET /api/health/db-identity: hash of database name,
+//      OID and cluster start time) and compares it with the fingerprint of its own
+//      DATABASE_URL (read-only query). If the endpoint is unreachable, disabled, errors, or
+//      the fingerprints differ, the script refuses. Nothing has been written by then: no
+//      sign-up, no request that writes, no database write.
+//      The endpoint is on under `npm run dev`; for a production build (`npm start`) start the
+//      server with EXPOSE_DB_IDENTITY=1.
+//   4. That database must carry the explicit TEST-DATABASE MARKER, as reported by the running
+//      server through the same endpoint: the PostgreSQL comment on the database must be exactly
+//      `fitworkoutfoodtracker:test-database:v1:<database name>`. It's created only deliberately,
+//      when provisioning the test database:
+//        node --env-file=<test env> scripts/mark-test-database.cjs --confirm <database name>
+//      A missing or invalid marker means immediate refusal. A database name containing "test" is
+//      NOT sufficient on its own.
+//
+// CLEANUP: the throwaway users this run creates (live-check-<n>-<run>@example.test) are
+// deleted in a `finally` block, including after failures, crashes and Ctrl+C. Their
+// entries, targets, sessions and custom foods are removed by the schema's ON DELETE
+// CASCADE. Cached provider foods (the shared `Food` cache of real USDA/OFF data) are
+// kept, because they're normal app cache, not test data.
+//
+// LIVE EVIDENCE (fail-closed): the run counts as LIVE only if ALL of these hold.
+//   - FDC_BASE_URL / OFF_BASE_URL (the stub overrides) aren't set in this environment;
+//   - the server recorded the providers' real hosts as the origin of the foods it fetched
+//     (Food.origin = api.nal.usda.gov / world.openfoodfacts.org, read from the database);
+//   - result volumes look like the real services (USDA "banana" ≥ 5 results, OFF "nutella" ≥ 3).
+//   Otherwise it prints NOT LIVE and exits 3, whatever the individual checks say.
+//   "PASSED" additionally requires 0 FAIL and 0 NOT RUN.
+//
+// SECRETS: FDC_API_KEY is read only to confirm that no API response contains it. It is
+// never printed, logged or written to the report. DATABASE_URL credentials are never
+// printed; only the host and database name are shown.
+//
+// Exit codes: 0 live PASSED · 1 live but FAIL / NOT RUN · 3 NOT LIVE · 4 refused (nothing written) ·
+// 2 cleanup incomplete or server/script database mismatch (manual cleanup needed).
+const fs = require("node:fs");
+const { createHash } = require("node:crypto");
+
+const BASE = process.env.BASE_URL || "http://localhost:3000";
+const REPORT = process.env.REPORT_FILE || "live-provider-report.json";
+const KEY = process.env.FDC_API_KEY || "";
+const REAL_HOSTS = { USDA: "api.nal.usda.gov", OPEN_FOOD_FACTS: "world.openfoodfacts.org" };
+const run = Date.now();
+const results = [];
+const bodies = []; // every response body, scanned for the key at the end
+const createdEmails = [];
+let registered = 0; // sign-ups the server confirmed (HTTP 200)
+const evidence = { notLive: [], origins: {} };
+let prisma = null;
+let interrupted = false;
+const inflight = new Set(); // HTTP requests not yet settled (cleanup waits for them)
+
+// ─── Safety guards (before anything is created) ──────────────────────────────
+function refuse(msg) {
+  console.error(`REFUSED (nothing was written): ${msg}`);
+  process.exit(4);
+}
+let baseUrl;
+try { baseUrl = new URL(BASE); } catch { refuse(`BASE_URL is not a valid URL`); }
+if (!["localhost", "127.0.0.1", "[::1]", "::1"].includes(baseUrl.hostname)) {
+  refuse(`BASE_URL host "${baseUrl.hostname}" is not local. This script only runs against a local app.`);
+}
+if (!process.env.DATABASE_URL) refuse("DATABASE_URL is not set (run with --env-file=.env, the same file the server uses).");
+let dbName, dbHost;
+try {
+  const u = new URL(process.env.DATABASE_URL);
+  dbName = decodeURIComponent(u.pathname.replace(/^\//, ""));
+  dbHost = u.hostname;
+} catch { refuse("DATABASE_URL can't be parsed."); }
+if (!/test/i.test(dbName) && process.env.LIVE_CHECK_ALLOW_DATABASE !== dbName) {
+  refuse(`database "${dbName}" doesn't look like a test database. Point the server and this script at a test database ` +
+    `(e.g. fitdb_test), or set LIVE_CHECK_ALLOW_DATABASE=${dbName} to accept throwaway rows (they are cleaned up).`);
+}
+const ORIGIN = baseUrl.origin;
+
+// Must match src/lib/server/db-identity.ts exactly (SQL, hash format, marker format).
+const DB_IDENTITY_SQL =
+  "SELECT current_database() || '|' || (SELECT oid::text FROM pg_database WHERE datname = current_database()) || '|' || extract(epoch from pg_postmaster_start_time())::text AS identity, " +
+  "shobj_description((SELECT oid FROM pg_database WHERE datname = current_database()), 'pg_database') AS marker";
+const TEST_DB_MARKER_PREFIX = "fitworkoutfoodtracker:test-database:v1:";
+const fingerprintOf = (identity) => createHash("sha256").update(`fwft-db-identity-v1|${identity}`).digest("hex");
+
+/**
+ * Guards 3 and 4: prove the running server uses this script's database, and that the
+ * server reports that database's explicit test marker. Read-only query here, read-only
+ * GET there. Refuses (exit 4) unless both are verified.
+ */
+async function verifyServerDatabase() {
+  let mine;
+  try {
+    prisma = prisma || new (require("@prisma/client").PrismaClient)();
+    const rows = await prisma.$queryRawUnsafe(DB_IDENTITY_SQL);
+    mine = fingerprintOf(rows[0].identity);
+  } catch (e) {
+    refuse(`can't read the identity of the script's database "${dbName}" (${e.message}).`);
+  }
+  let res, body;
+  try {
+    res = await fetch(`${BASE}/api/health/db-identity`, { signal: AbortSignal.timeout(10_000), cache: "no-store" });
+    body = await res.json().catch(() => null);
+  } catch (e) {
+    refuse(`can't reach ${BASE}/api/health/db-identity to verify the server's database (${e.message}). Is the app running?`);
+  }
+  if (res.status === 404) {
+    refuse("the server doesn't expose /api/health/db-identity, so its database can't be verified. Run it with `npm run dev`, " +
+      "or for a production build start it with EXPOSE_DB_IDENTITY=1.");
+  }
+  if (!res.ok || !body || typeof body.fingerprint !== "string" || !/^[0-9a-f]{64}$/.test(body.fingerprint)) {
+    refuse(`the server couldn't report its database identity (HTTP ${res.status}).`);
+  }
+  if (body.fingerprint !== mine) {
+    refuse(`the server's database does not match this script's database "${dbName}" on ${dbHost}. ` +
+      "Start the server with the same .env (test DATABASE_URL) as this script.");
+  }
+  const marker = body.testMarker;
+  if (marker === null || marker === undefined || marker === "") {
+    refuse(`the server's database "${dbName}" has no test-database marker. Mark a dedicated test database deliberately: ` +
+      `node --env-file=<test env> scripts/mark-test-database.cjs --confirm ${dbName}`);
+  }
+  if (typeof marker !== "string" || marker !== TEST_DB_MARKER_PREFIX + dbName) {
+    refuse(`the server's database "${dbName}" has an invalid test-database marker (expected the marker for "${dbName}"). ` +
+      "Re-mark it with scripts/mark-test-database.cjs only if it really is a dedicated test database.");
+  }
+  console.log(`Verified before any write: the server uses this script's database ("${dbName}"), and it carries a valid test-database marker.`);
+}
+
+// ─── Cleanup (always runs) ───────────────────────────────────────────────────
+// One shared promise: the signal handler and the normal `finally` path both await the
+// same cleanup, so neither can exit while the other's deletion is still running.
+let cleanupPromise = null;
+const cleanup = () => (cleanupPromise ??= doCleanup());
+async function doCleanup() {
+  if (!createdEmails.length) return;
+  // A request already sent (e.g. a sign-up) still completes on the server, so wait for
+  // every in-flight request to settle before deleting, or its row would be missed.
+  await Promise.allSettled([...inflight]);
+  try {
+    prisma = prisma || new (require("@prisma/client").PrismaClient)();
+    const users = await prisma.user.findMany({ where: { email: { in: createdEmails } }, select: { id: true } });
+    const ids = users.map((u) => u.id);
+    const del = await prisma.user.deleteMany({ where: { id: { in: ids } } }); // cascades entries/targets/sessions/custom foods
+    const leftUsers = await prisma.user.count({ where: { email: { in: createdEmails } } });
+    const leftEntries = await prisma.foodEntry.count({ where: { userId: { in: ids } } });
+    const leftFoods = await prisma.food.count({ where: { userId: { in: ids } } });
+    const leftTargets = await prisma.nutritionTarget.count({ where: { userId: { in: ids } } });
+    console.log(`Cleanup: removed ${del.count} test user(s); remaining → users ${leftUsers}, entries ${leftEntries}, custom foods ${leftFoods}, targets ${leftTargets}.`);
+    if (leftUsers + leftEntries + leftFoods + leftTargets > 0) process.exitCode = 2;
+    // Defense in depth (guard 3 should make this unreachable): fewer rows found than the
+    // server confirmed would mean the server wrote to a different database.
+    if (del.count < registered) {
+      console.error(`Cleanup MISMATCH: the server confirmed ${registered} sign-up(s) but only ${del.count} were found in "${dbName}". ` +
+        `The server is using a different database. Remove users matching live-check-*-${run}@example.test there manually, ` +
+        `and start the server with the same .env as this script.`);
+      process.exitCode = 2;
+    }
+  } catch (e) {
+    console.error(`Cleanup FAILED (${e.message}). Remove users matching live-check-*-${run}@example.test manually.`);
+    process.exitCode = 2;
+  } finally {
+    if (prisma) await prisma.$disconnect().catch(() => {});
+  }
+}
+for (const sig of ["SIGINT", "SIGTERM"]) {
+  process.on(sig, async () => {
+    interrupted = true; // no new requests from here on
+    console.error(`\nInterrupted (${sig}); waiting for in-flight requests, then cleaning up…`);
+    await cleanup();
+    process.exit(process.exitCode === 2 ? 2 : 130); // 2 = cleanup incomplete
+  });
+}
+
+// ─── HTTP helper ─────────────────────────────────────────────────────────────
+function client() {
+  let cookie = "";
+  const call = async (method, path, body) => {
+    if (interrupted) throw new Error("interrupted");
+    const t0 = Date.now();
+    const req = fetch(BASE + path, {
+      method, body: body !== undefined ? JSON.stringify(body) : undefined,
+      headers: { ...(body !== undefined ? { "Content-Type": "application/json" } : {}), Origin: ORIGIN, ...(cookie ? { Cookie: cookie } : {}) },
+    });
