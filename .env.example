# PostgreSQL connection string
DATABASE_URL="postgresql://fit:fitdev@localhost:5432/fitdb?schema=public"

# ─── Food databases (Phase 2) — server-side only, never exposed to the browser ───
# USDA FoodData Central API key: https://fdc.nal.usda.gov/api-key-signup
# Without it, generic-food search reports "not configured" and other sources keep working.
# (api.data.gov's public DEMO_KEY works for light local testing; it is heavily rate-limited.)
FDC_API_KEY=""

# Open Food Facts needs no key, but asks clients to identify themselves.
# Set a contact (email or URL) for the User-Agent, or override the whole header.
# OFF_CONTACT="you@example.com"
# OFF_USER_AGENT="FitWorkoutFoodTracker/0.2 (you@example.com)"

# Production: number of reverse proxies in front of the app that append to X-Forwarded-For.
# Enables per-client login and registration limits. Only set it if the app can't be reached except
# through them, otherwise callers can forge their address. Leave unset when there is no proxy.
# TRUST_PROXY_HOPS=1

# Production: exact addresses allowed to sign up, comma-separated. Empty means nobody can. There are no
# wildcards, and anything else refuses startup. Sign-up is open only under `next dev`.
# REGISTRATION_ALLOWLIST=

# Production: required, and must be HTTPS. See docs/PHASE_4_0_3_DEPLOYMENT.md for what else startup refuses.
# The app's public origin. Mutating requests must match it exactly.
# APP_ORIGIN="https://app.example.com"

# TEST ONLY: `next start` is always production mode, so the automated suites set these. They're honoured only
# for fitdb_test or fitdb_test_other on this machine, and refuse startup anywhere else.
# FIT_LOCAL_TEST_SERVER=1
# FIT_TEST_OPEN_REGISTRATION=1

# TEST ONLY: scales provider rate-limit budgets (default 1). The general integration/E2E
# suites set e.g. 100 because they make many provider calls per minute. Never set in production.
# FOOD_RATE_LIMIT_MULTIPLIER=1

# Optional base-URL overrides, used by automated tests with scripts/stub-food-apis.cjs.
# FDC_BASE_URL="https://api.nal.usda.gov/fdc/v1"
# OFF_BASE_URL="https://world.openfoodfacts.org"

# Label scanning (server-side only). Off unless both the key and the model are set. Each scan is a
# paid request. There's no default model: choose one after measuring accuracy on real labels.
# ANTHROPIC_API_KEY=""
# LABEL_EXTRACTION_MODEL=""
# Optional: low, medium, high, xhigh or max. Lower effort costs less. Unset uses the model's default.
# LABEL_EXTRACTION_EFFORT=""
# Meal-photo identification (server-side only). Off unless ANTHROPIC_API_KEY and this model are set.
# It has its own model, with no default, and shares the scan limits below. Each photo is a paid request.
# MEAL_IDENTIFICATION_MODEL=""
# Optional: low, medium, high, xhigh or max. Unset uses the model's default.
# MEAL_IDENTIFICATION_EFFORT=""
# Scans allowed per rolling 24 hours, per server process. Counts reset on restart, so also set a
# spending limit with the provider. Defaults: 30 per user, 300 overall. 0 turns scanning off.
# LABEL_SCAN_USER_DAILY_LIMIT="30"
# LABEL_SCAN_GLOBAL_DAILY_LIMIT="300"
