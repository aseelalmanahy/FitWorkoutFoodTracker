// Phase 1 schema: identity, profile, exercise library, workout planning,
// workout logging. Later-phase tables are documented in docs/ARCHITECTURE.md.
//
// Unit convention: all masses are stored in kilograms, all lengths in
// centimetres, all durations in seconds. Conversion happens at the UI edge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Filled from Phase 4.0.5. Null means no acceptance is recorded.
  termsVersion    String?
  termsAcceptedAt DateTime?

  sessions         Session[]
  accountTokens    AccountToken[]
  bodyMetrics      BodyMetric[]
  profile          Profile?
  exercises        Exercise[]
  templates        WorkoutTemplate[]
  programs         WorkoutProgram[]
  scheduleSlots    ScheduleSlot[]
  workoutSessions  WorkoutSession[]
  foods            Food[]
  foodEntries      FoodEntry[]
  nutritionTargets NutritionTarget[]
  feedback         Feedback[]
  gyms             GymLocation[]
  gymEquipment     GymEquipment[]
}

/// Server-side session. `id` is the SHA-256 hash of the random cookie token,
/// so a database leak does not expose usable session tokens.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AccountTokenPurpose {
  SIGNUP
  PASSWORD_RESET
}

/// A one-time emailed link. `id` is the SHA-256 hash of the token, like Session, so a database leak
/// exposes nothing usable. Several can be live for one address, and using one removes the rest.
model AccountToken {
  id        String              @id
  purpose   AccountTokenPurpose
  /// Normalized. For SIGNUP, it's what the account is created with.
  email     String
  /// Null for SIGNUP, as no account exists yet. That's why deletion also removes tokens by address.
  userId    String?
  expiresAt DateTime
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

enum BodyMetricKind {
  WEIGHT
}

/// A dated body measurement, in SI units: kilograms for weight. Only weight is built, and the kind leaves room.
/// One a day. It's separate from Profile.currentWeightKg, which nothing changes when this is written.
model BodyMetric {
  id        String         @id @default(cuid())
  userId    String
  kind      BodyMetricKind @default(WEIGHT)
  date      DateTime       @db.Date
  value     Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, date])
}

// ─── Profile ────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
}

enum FitnessGoal {
  FAT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  STRENGTH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model Profile {
  userId                String              @id
  name                  String
  /// Date of birth rather than age so the value stays correct over time.
  birthDate             DateTime            @db.Date
  sex                   Sex?
  heightCm              Float?
  currentWeightKg       Float?
  goalWeightKg          Float?
  goal                  FitnessGoal?
  activityLevel         ActivityLevel?
  experience            TrainingExperience?
  workoutDaysPerWeek    Int?
  unitSystem            UnitSystem          @default(IMPERIAL)
  /// IANA time zone, used for day/week boundaries (e.g. "America/New_York").
  timezone              String              @default("UTC")
  /// Unused: nothing reads or writes it. Kept until dropping it is separately approved.
  calorieTargetOverride Int?
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Exercise library ───────────────────────────────────────────────────────

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FULL_BODY
  OTHER
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

/// userId = null → built-in exercise visible to everyone (seeded).
/// userId set   → custom exercise owned by that user.
model Exercise {
  id            String      @id @default(cuid())
  userId        String?
  name          String
  primaryMuscle MuscleGroup
  equipment     Equipment
  createdAt     DateTime    @default(now())

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateExercises TemplateExercise[]
  sessionExercises  SessionExercise[]
  substitutedIn     SessionExercise[]  @relation("PlannedExercise")
  machineProfiles   GymEquipment[]

  @@unique([userId, name])
  @@index([name])
}

// ─── Planning ───────────────────────────────────────────────────────────────

/// A reusable workout definition, e.g. "Upper Body A".
/// UI-01: a program groups the workout days of one plan (an import, or plans the person grouped). Optional: a plan
/// without one is an individual plan. Deleting a program keeps its plans, as individual ones.
model WorkoutProgram {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// "import" or "manual": where the grouping came from.
  origin    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@index([userId])
}

model WorkoutTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  notes     String?
  /// UI-01: the program this plan is a day of, and its place in it. Both null for an individual plan.
  programId       String?
  programPosition Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   WorkoutProgram?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises TemplateExercise[]
  slots     ScheduleSlot[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@index([programId, programPosition])
}

model TemplateExercise {
  id             String  @id @default(cuid())
  templateId     String
  exerciseId     String
  position       Int
  targetSets     Int
  targetRepsMin  Int
  targetRepsMax  Int
  targetWeightKg Float?
  restSeconds    Int?
  notes          String?

  template         WorkoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise         Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sessionExercises SessionExercise[]

  @@index([templateId, position])
}

/// Weekly schedule entry. weekday: 0 = Monday … 6 = Sunday (ISO order).
/// A weekday with no slots is a rest day.
model ScheduleSlot {
  id         String @id @default(cuid())
  userId     String
  weekday    Int
  templateId String
  position   Int    @default(0)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
}

// ─── Logging ────────────────────────────────────────────────────────────────

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

model WorkoutSession {
  id            String        @id @default(cuid())
  userId        String
  templateId    String?
  name          String
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  notes         String?
  /// Where it was done, if the person said. Null for every workout before gyms existed, and never guessed.
  gymLocationId String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  gym       GymLocation?      @relation(fields: [gymLocationId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([gymLocationId])
}

model SessionExercise {
  id                 String            @id @default(cuid())
  sessionId          String
  exerciseId         String
  position           Int
  restSeconds        Int?
  notes              String?
  /// The specific machine it was done on, if the person chose one. Its history is kept apart from other machines'
  /// and from sets with no machine, as different machines aren't mechanically equivalent. Null otherwise.
  gymEquipmentId     String?
  /// For a swap: the planned exercise's row in this workout, which keeps its own sets. Its exercise is plannedExerciseId.
  substitutesId      String?
  plannedExerciseId  String?
  /// The plan entry this row was started from, so "also change my plan" changes that entry and no other, even when the
  /// plan has the same exercise twice. Cleared when the entry goes (saving a plan replaces its entries), and then the
  /// plan isn't changed from this workout. Null for exercises added during the workout.
  templateExerciseId String?
  session            WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise           Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  machine            GymEquipment?     @relation(fields: [gymEquipmentId], references: [id], onDelete: Restrict)
  substitutes        SessionExercise?  @relation("Substitution", fields: [substitutesId], references: [id], onDelete: SetNull)
  substitutedBy      SessionExercise[] @relation("Substitution")
  plannedExercise    Exercise?         @relation("PlannedExercise", fields: [plannedExerciseId], references: [id], onDelete: Restrict)
  templateExercise   TemplateExercise? @relation(fields: [templateExerciseId], references: [id], onDelete: SetNull)
  sets               SetEntry[]

  @@index([sessionId, position])
  @@index([exerciseId])
  @@index([exerciseId, gymEquipmentId])
  @@index([substitutesId])
  @@index([templateExerciseId])
}

model SetEntry {
  id                String   @id @default(cuid())
  sessionExerciseId String
  setNumber         Int
  reps              Int
  /// External load in kg. 0 for unloaded bodyweight movements.
  weightKg          Float
  isWarmup          Boolean  @default(false)
  /// Rate of perceived exertion (1–10), optional.
  rpe               Float?
  createdAt         DateTime @default(now())

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, setNumber])
}

// ─── Nutrition (Phase 2) ────────────────────────────────────────────────────
//
// Nutrient convention: Food stores values per 100 g (or 100 ml) of the food,
// as published by USDA FoodData Central and Open Food Facts. NULL means
// "not reported by the source", which is distinct from 0.

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  CUSTOM
}

enum BasisUnit {
  G
  ML
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum TargetSource {
  SUGGESTED
  MANUAL
}

/// Cached external food or a user's custom food.
/// External foods: userId NULL, unique on (source, sourceId).
/// Custom foods: userId = owner, sourceId = generated id.
model Food {
  id            String     @id @default(cuid())
  source        FoodSource
  /// USDA fdcId, Open Food Facts barcode, or a generated id for custom foods.
  sourceId      String
  userId        String?
  name          String
  brand         String?
  barcode       String?
  /// Source-specific category, e.g. USDA "Foundation", "Branded".
  dataType      String?
  basisUnit     BasisUnit  @default(G)
  kcalPer100    Decimal?   @db.Decimal(9, 3)
  proteinPer100 Decimal?   @db.Decimal(9, 3)
  carbsPer100   Decimal?   @db.Decimal(9, 3)
  fatPer100     Decimal?   @db.Decimal(9, 3)
  fiberPer100   Decimal?   @db.Decimal(9, 3)
  /// When the external record was last fetched from its source.
  fetchedAt     DateTime?
  /// Host of the provider endpoint that produced this record (e.g. "api.nal.usda.gov").
  /// A cached record is reused only when this matches the currently configured
  /// endpoint, so data from a test stub or another endpoint is never served as live.
  origin        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  servings FoodServing[]
  entries  FoodEntry[]

  @@unique([source, sourceId])
  @@index([barcode])
  @@index([userId, name])
}

/// A named serving, expressed in the food's basis unit (g or ml).
model FoodServing {
  id        String  @id @default(cuid())
  foodId    String
  label     String
  amount    Decimal @db.Decimal(9, 3)
  isDefault Boolean @default(false)
  position  Int     @default(0)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, label])
}

/// One logged food. Nutrition per 100 units is snapshotted so history is
/// unaffected by later changes to the cached food; totals are stored for
/// aggregation and are always recomputed from the snapshot on edit.
model FoodEntry {
  id       String   @id @default(cuid())
  userId   String
  /// Local calendar date in the user's time zone.
  date     DateTime @db.Date
  mealType MealType
  foodId   String?

  foodName      String
  brand         String?
  basisUnit     BasisUnit
  kcalPer100    Decimal?  @db.Decimal(9, 3)
  proteinPer100 Decimal?  @db.Decimal(9, 3)
  carbsPer100   Decimal?  @db.Decimal(9, 3)
  fatPer100     Decimal?  @db.Decimal(9, 3)
  fiberPer100   Decimal?  @db.Decimal(9, 3)

  servingLabel  String
  /// Size of one serving in basis units (g/ml).
  servingAmount Decimal @db.Decimal(9, 3)
  /// Number of servings consumed.
  quantity      Decimal @db.Decimal(8, 3)

  kcal    Decimal? @db.Decimal(10, 2)
  protein Decimal? @db.Decimal(10, 2)
  carbs   Decimal? @db.Decimal(10, 2)
  fat     Decimal? @db.Decimal(10, 2)
  fiber   Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, foodId])
}

/// Effective-dated targets. The target for date D is the row with the latest
/// effectiveFrom <= D, so changing a target never rewrites past days.
/// A null macro means "not set", and zero stays zero. A null kcal means "no target from this date":
/// the person stopped using one, and every macro is null too.
/// The migration adds two CHECK constraints this file can't express: NutritionTarget_stop_shape and
/// NutritionTarget_carbs_derived. Carbs are stored only when protein and fat both are.
model NutritionTarget {
  id            String       @id @default(cuid())
  userId        String
  effectiveFrom DateTime     @db.Date
  kcal          Int?
  proteinG      Int?
  carbsG        Int?
  fatG          Int?
  source        TargetSource
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
}

/// Beta feedback (phase 5). Private to the person who wrote it, and to administrators named by user ID in the server
/// setting ADMIN_USER_IDS. Deleted with the account. No attachments, screenshots or device details are stored.
model Feedback {
  id            String            @id @default(cuid())
  userId        String
  category      FeedbackCategory
  /// What the person wrote, at most 2,000 characters. It can contain personal details, so it's only ever exported for
  /// review in redacted form, under a pseudonym.
  description   String
  /// The app page it was sent from, such as "/nutrition", with no query or fragment.
  route         String?
  status        FeedbackStatus    @default(NEW)
  severity      FeedbackSeverity?
  priority      FeedbackPriority?
  /// Another report this one repeats. Cleared if that report is deleted.
  duplicateOfId String?
  /// An administrator's decision, and a link to the approved development task. Administrators only.
  decisionNote  String?
  taskLink      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  duplicateOf Feedback?  @relation("FeedbackDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Feedback[] @relation("FeedbackDuplicate")

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum FeedbackCategory {
  BUG
  FEATURE
  IMPROVEMENT
  UX
  GENERAL
}

enum FeedbackStatus {
  NEW
  TRIAGED
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
  DUPLICATE
}

enum FeedbackSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FeedbackPriority {
  P0
  P1
  P2
  P3
}

/// A place the person trains, named by them (multi-gym). Private to them; no address or location is stored.
model GymLocation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment GymEquipment[]
  sessions  WorkoutSession[]

  @@unique([userId, name])
  @@index([userId])
}

/// What a gym has. Without a name: a kind of equipment available there (alternatives use these). With a name: one
/// specific machine or station, optionally for one exercise ("Chest Press, Machine A"), whose history stays its own.
model GymEquipment {
  id         String    @id @default(cuid())
  userId     String
  gymId      String
  kind       Equipment
  name       String?
  exerciseId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym              GymLocation       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercise         Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sessionExercises SessionExercise[]

  @@unique([gymId, kind, name])
  @@index([userId])
  @@index([gymId])
}
