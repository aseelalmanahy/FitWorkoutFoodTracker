    "anthropic": { "noticeName": "Anthropic", "receives": "Label or meal photos, only if its settings are present", "state": "conditional", "settings": ["ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL", "LABEL_EXTRACTION_MODEL", "LABEL_EXTRACTION_EFFORT", "MEAL_IDENTIFICATION_MODEL", "MEAL_IDENTIFICATION_EFFORT"] },
