{
  "name": "fit-workout-food-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:api": "node --test scripts/nutrition-api.test.cjs",
    "test:e2e": "node scripts/e2e-smoke.cjs && node scripts/e2e-nutrition.cjs",
    "stub:food-apis": "node scripts/stub-food-apis.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
