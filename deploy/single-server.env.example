# TEMPLATE for option A (one server). Copy to deploy/single-server.env on the server (Git ignores it), mode 600, beside
# deploy/production.env. These settings are for the database container and the host scripts, not the app, which is why
# they're in a file of their own. Generate every password with:  openssl rand -base64 33 | tr -d '/+=' | cut -c1-40
# Nothing here is a real value.

# Where deploy/deploy.sh pulls the two images from (published by .github/workflows/release-image.yml).
APP_IMAGE_REPO=ghcr.io/aseelalmanahy/fitworkoutfoodtracker

# The database. Its name must not contain "test". The three passwords must differ, and be at least 24 characters.
# Production: fitworkoutfoodtracker. Staging: fitworkoutfoodtracker_staging (create-staging-account.cjs runs only on a
# database whose name ends in _staging). Use the same name in both URLs in production.env.
POSTGRES_DB=fitworkoutfoodtracker
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
FIT_MIGRATOR_PASSWORD=CHANGE_ME
FIT_APP_PASSWORD=CHANGE_ME
# production.env then holds, with the same passwords (URL-safe, as generated above):
#   APP_DATABASE_URL=postgresql://fit_app:<FIT_APP_PASSWORD>@db:5432/fitworkoutfoodtracker?sslmode=require&connection_limit=10
#   MIGRATION_DATABASE_URL=postgresql://fit_migrator:<FIT_MIGRATOR_PASSWORD>@db:5432/fitworkoutfoodtracker?sslmode=require

# Backups (deploy/backup.sh). The age PUBLIC key only: the private key stays with the owner, never on the server, so a
# compromised server can't read old backups. Create the pair on your own computer with: age-keygen -o fit-backup.key
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# An rclone remote and path for the offsite copy, e.g. hetzner-s3:fit-backups/production. Empty keeps backups local only.
BACKUP_RCLONE_REMOTE=
# Days to keep, locally and offsite (Decision 12, proposed 14).
BACKUP_RETENTION_DAYS=14
