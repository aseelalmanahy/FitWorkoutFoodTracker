# TEMPLATE. Copy to deploy/production.env on the server, which .gitignore keeps out of Git, and fill in every value.
# These placeholders are refused by the startup preflight on purpose. Nothing here is a real value.

APP_IMAGE_TAG=CHANGE_ME_git_commit_sha
APP_DOMAIN=CHANGE_ME.example.invalid
APP_ORIGIN=https://CHANGE_ME.example.invalid

# Managed PostgreSQL. Two credentials, as in deploy/database-roles.sql, and TLS is required.
APP_DATABASE_URL=postgresql://fit_app:CHANGE_ME@CHANGE_ME.example.invalid:5432/CHANGE_ME?sslmode=require
MIGRATION_DATABASE_URL=postgresql://fit_migrator:CHANGE_ME@CHANGE_ME.example.invalid:5432/CHANGE_ME?sslmode=require

# Comma-separated exact addresses. Empty means nobody can register. There are no wildcards.
REGISTRATION_ALLOWLIST=

# Optional. Without it, generic-food search reports "not configured" and everything else works.
FDC_API_KEY=
OFF_CONTACT=

# Must stay unset in production, and the app refuses to start otherwise: any AI key or model, EXPOSE_DB_IDENTITY,
# FDC_BASE_URL, OFF_BASE_URL, FOOD_RATE_LIMIT_MULTIPLIER, FIT_LOCAL_TEST_SERVER, FIT_TEST_OPEN_REGISTRATION.

# Email (EMAIL-01). All three, or none: without them, sign-up and password-reset emails aren't sent. MAIL_FROM must be
# an address at a domain verified with the provider. The key is a secret: only on the server, never in Git.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=

# On-device reading, with no paid service and nothing sent elsewhere. Only "local" is accepted.
# LABEL_OCR=local          label photos, by text recognition (its English data is an npm dependency)
# MEAL_RECOGNITION=local   meal photos, by a model that must be in the image: build with --build-arg WITH_MEAL_MODEL=1
